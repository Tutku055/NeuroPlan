using System;
using System.Collections.Generic;
using NeuroPlan.Domain.Enums;

namespace NeuroPlan.Domain.Entities
{
    public class TaskItem : BaseEntity
    {
        public int CompanyId { get; set; }
        public int ProjectId { get; set; }
        public int? TaskCategoryId { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public int Weight { get; set; }
        public int UnitQuantity { get; set; } = 1;
        public EntityStatus Status { get; set; } = EntityStatus.Waiting;

        // Navigation Properties
        public Project Project { get; set; }
        public TaskCategory TaskCategory { get; set; }
        public ICollection<TaskDependency> PredecessorDependencies { get; set; }
        public ICollection<TaskDependency> SuccessorDependencies { get; set; }
    }
}
